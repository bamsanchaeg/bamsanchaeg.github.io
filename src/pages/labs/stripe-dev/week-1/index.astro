---
import Chip from '../../../../components/ui/Chip.astro';
import Button from '../../../../components/ui/Button.astro';
import SectionLabel from '../../../../components/ui/SectionLabel.astro';
import Base from '../../../../layouts/Base.astro';
import '../../../../styles/lab.css';

const PRIMITIVES = [
  { name: '--ink', light: '#2f2f2f', dark: '#e6e7e2', role: '글자 · 선 · 코드 배경' },
  { name: '--accent', light: '#7d8f71', dark: '#9fb392', role: '단 하나의 포인트' },
  { name: '--canvas', light: '#f4f5f0', dark: '#17181a', role: '페이지 바탕' },
  { name: '--surface', light: '#ffffff', dark: '#202225', role: '콘텐츠 면' },
];
const DERIVED = [
  { name: '--ink-body', formula: 'ink 90% + canvas', role: '본문' },
  { name: '--ink-muted', formula: 'ink 66% α', role: '보조 텍스트 · AA 4.5:1' },
  { name: '--ink-line-strong', formula: 'ink 24% α', role: '강조 선' },
  { name: '--ink-line', formula: 'ink 12% α', role: '헤어라인' },
  { name: '--accent-ink', formula: 'accent 55% + ink', role: '액센트 위 글자 · AA 5.2:1' },
  { name: '--accent-soft', formula: 'accent 18% + surface', role: '칩 · hover 배경' },
];
const BEFORE_AFTER = [
  { before: '--muted: #757871', after: '--ink-muted: color-mix(ink 66%, transparent)', note: '잉크 파생. 다크에서 자동 반전' },
  { before: '--line: #dedfd9', after: '--ink-line: color-mix(ink 12%, transparent)', note: '' },
  { before: '--line-strong: #c5c8bf', after: '--ink-line-strong: color-mix(ink 24%, transparent)', note: '' },
  { before: '--accent-dark: #596650', after: '--accent-ink: color-mix(accent 55%, ink)', note: '' },
  { before: '--accent-soft: #e7ebdf', after: '--accent-soft: color-mix(accent 18%, surface)', note: '' },
  { before: '--code: #363936', after: '--code: var(--ink)', note: '별도 색 불필요' },
  { before: 'color: #596650 / #454545 / #f1f1ed / white (7곳)', after: 'var(--accent-ink) / var(--ink-body) / var(--canvas)', note: '하드코딩 0' },
];
const SAMPLE_POSTS = [
  { cat: '공지', date: '2026.09.06', title: '밤산책' },
  { cat: 'CSS', date: '2026.09.18', title: '행 위에 마우스를 올려 보세요 — 배경이 액센트로 반전됩니다' },
];
---

<Base title="Week 1 · 파운데이션" description="원색 4개 + 파생 토큰으로 site.css 를 다시 짜고, 액센트 반전 hover 와 다크 모드를 추가한 기록">
  <section class="lab-intro">
    <SectionLabel><a href="/labs/stripe-dev/" style="color:inherit;text-decoration:none">Lab · stripe.dev study</a> / Week 1</SectionLabel>
    <h1>파운데이션</h1>
    <p>
      이 페이지가 아니라 <strong>사이트 전체</strong>가 산출물입니다. 우측 상단 토글로 다크 모드를 켜 보세요 —
      원색 4개만 바뀌고 나머지는 파생 토큰이 따라옵니다. 홈과 아카이브의 글 목록 hover 도 바뀌었습니다.
    </p>
  </section>

  <section class="lab-section" aria-labelledby="prim-title">
    <h2 id="prim-title">원색 4개</h2>
    <p class="lead">stripe.dev 원리 03 — 테마는 이 넷만 재정의한다. 아래 칩은 실제 CSS 변수를 그대로 쓰므로 테마를 바꾸면 함께 바뀝니다.</p>
    <div class="token-grid">
      {PRIMITIVES.map((t) => (
        <div class="token">
          <div class="chip" style={`background: var(${t.name})`}></div>
          <code>{t.name}</code>
          <small>{t.role}<br />☀ {t.light} · ☾ {t.dark}</small>
        </div>
      ))}
    </div>
  </section>

  <section class="lab-section" aria-labelledby="derived-title">
    <h2 id="derived-title">알파 계층 · 파생 6개</h2>
    <p class="lead">stripe.dev 원리 02 — 같은 잉크에 투명도만 달리해 위계를 만든다. 고정 hex 6개가 <code>color-mix()</code> 6줄이 됐다.</p>
    <div class="token-grid">
      {DERIVED.map((t) => (
        <div class="token">
          <div class:list={['chip', { 'chip--text': t.name.includes('ink-body') || t.name.includes('muted') || t.name.includes('accent-ink') }]} style={t.name.includes('ink-body') || t.name.includes('muted') || t.name.includes('accent-ink') ? `color: var(${t.name})` : `background: var(${t.name})`}>
            {(t.name.includes('ink-body') || t.name.includes('muted') || t.name.includes('accent-ink')) && 'Aa 가'}
          </div>
          <code>{t.name}</code>
          <small>{t.role}<br />{t.formula}</small>
        </div>
      ))}
    </div>
  </section>

  <section class="lab-section" aria-labelledby="hover-title">
    <h2 id="hover-title">액센트 반전 hover</h2>
    <p class="lead">stripe.dev 원리 01 — 원본은 라임으로 완전 반전하지만, 글 사이트에선 눈에 띄는 정도가 과해서 <code>accent-soft</code> 배경 반전으로 낮췄다. 행 전체가 클릭 영역임이 드러난다.</p>
    <div class="demo">
      <ol class="post-list">
        {SAMPLE_POSTS.map((p) => (
          <li>
            <a href="#hover-title">
              <span class="post-meta"><Chip>{p.cat}</Chip><time>{p.date}</time></span>
              <strong>{p.title}</strong>
              <span class="post-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="lab-section" aria-labelledby="diff-title">
    <h2 id="diff-title">site.css 에서 바뀐 것</h2>
    <p class="lead">컴포넌트 규칙은 hover 3줄과 하드코딩 색 7곳 외엔 손대지 않았다. 별칭(<code>--muted</code> 등)을 남겨 기존 셀렉터가 그대로 동작한다.</p>
    <table class="diff-table">
      <thead><tr><th>Before</th><th>After</th><th>비고</th></tr></thead>
      <tbody>
        {BEFORE_AFTER.map((r) => (
          <tr><td><code class="del">{r.before}</code></td><td><code class="add">{r.after}</code></td><td>{r.note}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="lab-section" aria-labelledby="next-title">
    <h2 id="next-title">다음 주</h2>
    <p class="lead">원자 컴포넌트 — 지금 흩어져 있는 <code>.status</code>, <code>.text-button</code>, <code>.section-label</code> 을 상태와 크기가 있는 Chip · Button · Label 로 승격. Figma 컴포넌트와 1:1 로 맞춘다.</p>
    <Button href="/labs/stripe-dev/week-2/">2주차로 →</Button>
  </section>
</Base>
