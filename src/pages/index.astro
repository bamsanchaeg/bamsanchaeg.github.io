---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 8);
---

<Base title="HOME">
  <section class="intro" aria-label="사이트 소개">
    <p class="section-label">Personal archive</p>
    <p>웹, 디자인, 코드에 관한 기록.</p>
  </section>
  <section class="recent" aria-labelledby="recent-title">
    <div class="section-heading">
      <h2 id="recent-title">최근 기록</h2>
      <a href="/archive/">전체 보기</a>
    </div>
    <PostList items={posts} variant="recent" />
  </section>
</Base>
