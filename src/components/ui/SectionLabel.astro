---
/**
 * SectionLabel — 페이지·섹션 상단의 작은 대문자 라벨. Figma `Section Label` 컴포넌트와 1:1.
 * 액센트가 텍스트 색으로 쓰이는 유일한 곳.
 */
interface Props {
  as?: 'p' | 'span' | 'div';
  class?: string;
}
const { as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['section-label', className]}><slot /></Tag>
