---
import Chip from '../components/ui/Chip.astro';
import Base from './Base.astro';
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  date: Date;
  category: string;
  tags: string[];
  description?: string;
}
const { title, date, category, tags, description } = Astro.props;
---

<Base title={title} description={description}>
  <article class="post-view">
    <header class="post-header">
      <a class="back-link" href="/archive/">← Archive</a>
      <div class="post-meta">
        <Chip>{category}</Chip>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </div>
      <h1>{title}</h1>
    </header>

    <div class="post-body"><slot /></div>

    {tags.length > 0 && (
      <footer class="post-footer" aria-label="태그">
        {tags.map((tag) => <span>#{tag}</span>)}
      </footer>
    )}
  </article>
</Base>
